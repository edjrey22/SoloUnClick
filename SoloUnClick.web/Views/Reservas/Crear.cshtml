@model SoloUnClick.web.Models.ViewModels.ReservaCrearViewModel
@{
    ViewData["Title"] = "Reservar - " + Model.Paquete.Nombre;
}

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Paquetes" asp-action="Index">Paquetes</a></li>
            <li class="breadcrumb-item"><a asp-controller="Paquetes" asp-action="Details" asp-route-id="@Model.Paquete.Id">@Model.Paquete.Nombre</a></li>
            <li class="breadcrumb-item active" aria-current="page">Reservar</li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="fw-bold mb-3">
                <i class="bi bi-calendar-check text-primary me-2"></i>Completa tu Reserva
            </h1>
            <p class="text-muted">Estás a un paso de vivir una experiencia inolvidable</p>
        </div>
    </div>

    <!-- Mensajes de error -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Formulario de Reserva -->
        <div class="col-lg-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Información de la Reserva
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Crear" method="post" id="reservaForm">
                        <input type="hidden" asp-for="Formulario.PaqueteTuristicoId" />
                        <input type="hidden" asp-for="Formulario.PrecioTotal" id="precioTotalHidden" />

                        <div class="mb-4">
                            <label asp-for="Formulario.FechaViaje" class="form-label fw-bold">
                                <i class="bi bi-calendar3 me-1"></i>Fecha de Viaje
                            </label>
                            <input type="date" 
                                   asp-for="Formulario.FechaViaje" 
                                   class="form-control form-control-lg" 
                                   id="fechaViaje"
                                   min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")"
                                   required />
                            <span asp-validation-for="Formulario.FechaViaje" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Selecciona la fecha en que iniciarás tu viaje
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Formulario.NumeroPasajeros" class="form-label fw-bold">
                                <i class="bi bi-people me-1"></i>Número de Pasajeros
                            </label>
                            <div class="input-group input-group-lg">
                                <button type="button" class="btn btn-outline-secondary" id="btnMenos">
                                    <i class="bi bi-dash-lg"></i>
                                </button>
                                <input type="number" 
                                       asp-for="Formulario.NumeroPasajeros" 
                                       class="form-control text-center" 
                                       id="numeroPasajeros"
                                       min="1"
                                       max="20"
                                       required />
                                <button type="button" class="btn btn-outline-secondary" id="btnMas">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Formulario.NumeroPasajeros" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Máximo 20 pasajeros por reserva
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Resumen de Precio -->
                        <div class="bg-light p-4 rounded mb-4">
                            <h6 class="fw-bold mb-3">Resumen de Costos</h6>
                            
                            <div class="d-flex justify-content-between mb-2">
                                <span>Precio por persona:</span>
                                <span class="fw-bold">S/ <span id="precioPorPersona">@Model.Paquete.PrecioPorPersona.ToString("N2")</span></span>
                            </div>
                            
                            <div class="d-flex justify-content-between mb-2">
                                <span>Número de pasajeros:</span>
                                <span class="fw-bold">×<span id="displayPasajeros">@Model.Formulario.NumeroPasajeros</span></span>
                            </div>
                            
                            <hr>
                            
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Total a Pagar:</h5>
                                <h3 class="text-primary fw-bold mb-0">
                                    S/ <span id="precioTotalDisplay">@Model.Formulario.PrecioTotal.ToString("N2")</span>
                                </h3>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Confirmar Reserva
                            </button>
                            <a asp-controller="Paquetes" asp-action="Details" asp-route-id="@Model.Paquete.Id" 
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Resumen del Paquete -->
        <div class="col-lg-5">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-header bg-white">
                    <h5 class="mb-0 fw-bold">Resumen del Paquete</h5>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.Paquete.RutaImagenPrincipal))
                {
                    <img src="@Model.Paquete.RutaImagenPrincipal" 
                         class="card-img-top" 
                         alt="@Model.Paquete.Nombre" 
                         style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                         style="height: 200px;">
                        <i class="bi bi-image text-secondary" style="font-size: 4rem;"></i>
                    </div>
                }

                <div class="card-body">
                    <span class="badge bg-primary mb-2">@Model.Paquete.TipoViaje</span>
                    <h5 class="card-title fw-bold">@Model.Paquete.Nombre</h5>
                    
                    <hr>
                    
                    <div class="mb-3">
                        <div class="d-flex align-items-start mb-2">
                            <i class="bi bi-geo-alt text-danger me-2 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Ubicación</small>
                                <strong>@Model.Paquete.Ubicacion</strong>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-start mb-2">
                            <i class="bi bi-map text-success me-2 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Región</small>
                                <strong>@Model.Paquete.Region</strong>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-start">
                            <i class="bi bi-calendar-event text-info me-2 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Duración</small>
                                <strong>@Model.Paquete.DuracionDias días</strong>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <h6 class="fw-bold mb-3">Incluye:</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Alojamiento
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Guía turístico
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Transporte
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Seguro de viaje
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function() {
            // Obtener elementos del DOM
            const numeroPasajerosInput = document.getElementById('numeroPasajeros');
            const displayPasajeros = document.getElementById('displayPasajeros');
            const precioTotalDisplay = document.getElementById('precioTotalDisplay');
            const precioTotalHidden = document.getElementById('precioTotalHidden');
            const btnMas = document.getElementById('btnMas');
            const btnMenos = document.getElementById('btnMenos');
            
            // Precio por persona (desde el servidor)
            const precioPorPersona = @Model.Paquete.PrecioPorPersona;

            // Función para calcular y actualizar el precio total
            function actualizarPrecioTotal() {
                const numeroPasajeros = parseInt(numeroPasajerosInput.value) || 1;
                const precioTotal = precioPorPersona * numeroPasajeros;
                
                // Actualizar displays
                displayPasajeros.textContent = numeroPasajeros;
                precioTotalDisplay.textContent = precioTotal.toFixed(2);
                precioTotalHidden.value = precioTotal.toFixed(2);
            }

            // Event listener para cambios en el input
            numeroPasajerosInput.addEventListener('input', actualizarPrecioTotal);
            numeroPasajerosInput.addEventListener('change', actualizarPrecioTotal);

            // Botón para incrementar pasajeros
            btnMas.addEventListener('click', function() {
                let valor = parseInt(numeroPasajerosInput.value) || 1;
                if (valor < 20) {
                    numeroPasajerosInput.value = valor + 1;
                    actualizarPrecioTotal();
                }
            });

            // Botón para decrementar pasajeros
            btnMenos.addEventListener('click', function() {
                let valor = parseInt(numeroPasajerosInput.value) || 1;
                if (valor > 1) {
                    numeroPasajerosInput.value = valor - 1;
                    actualizarPrecioTotal();
                }
            });

            // Prevenir que se ingresen valores inválidos
            numeroPasajerosInput.addEventListener('blur', function() {
                let valor = parseInt(this.value);
                if (isNaN(valor) || valor < 1) {
                    this.value = 1;
                } else if (valor > 20) {
                    this.value = 20;
                }
                actualizarPrecioTotal();
            });

            // Configurar fecha mínima para el date picker
            const fechaViajeInput = document.getElementById('fechaViaje');
            const hoy = new Date();
            hoy.setDate(hoy.getDate() + 1); // Mínimo mañana
            const fechaMinima = hoy.toISOString().split('T')[0];
            fechaViajeInput.setAttribute('min', fechaMinima);

            // Inicializar precio total
            actualizarPrecioTotal();
        })();
    </script>

    <style>
        .sticky-top {
            position: sticky;
            top: 20px;
            z-index: 1020;
        }

        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            opacity: 1;
        }

        #reservaForm button[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
            transition: all 0.3s ease;
        }
    </style>
}
