@model SoloUnClick.web.Models.ViewModels.ReservaConfirmacionViewModel
@{
    ViewData["Title"] = "Reserva Confirmada";
}

<div class="container my-5">
    <!-- Mensaje de éxito -->
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto text-center">
            <div class="success-icon mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 6rem;"></i>
            </div>
            <h1 class="display-5 fw-bold text-success mb-3">¡Reserva Confirmada!</h1>
            <p class="lead text-muted">
                Tu reserva ha sido procesada exitosamente. Te hemos enviado un correo de confirmación con todos los detalles.
            </p>
        </div>
    </div>

    <!-- Detalles de la Reserva -->
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>Detalles de tu Reserva
                    </h4>
                </div>
                <div class="card-body p-4">
                    <!-- Número de Reserva -->
                    <div class="alert alert-info mb-4">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <strong>Número de Reserva:</strong>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <h4 class="mb-0 fw-bold">#@Model.Reserva.Id.ToString("D6")</h4>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <!-- Paquete -->
                            <div class="mb-4">
                                <h6 class="text-muted mb-2">PAQUETE TURÍSTICO</h6>
                                <div class="d-flex align-items-start">
                                    @if (!string.IsNullOrEmpty(Model.Paquete.RutaImagenPrincipal))
                                    {
                                        <img src="@Model.Paquete.RutaImagenPrincipal" 
                                             alt="@Model.Paquete.Nombre" 
                                             class="rounded me-3"
                                             style="width: 80px; height: 80px; object-fit: cover;">
                                    }
                                    <div>
                                        <h5 class="fw-bold mb-1">@Model.Paquete.Nombre</h5>
                                        <p class="text-muted mb-0">
                                            <i class="bi bi-geo-alt me-1"></i>@Model.Paquete.Ubicacion
                                        </p>
                                        <p class="text-muted mb-0">
                                            <i class="bi bi-calendar-event me-1"></i>@Model.Paquete.DuracionDias días
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Fecha de Viaje -->
                            <div class="mb-4">
                                <h6 class="text-muted mb-2">FECHA DE VIAJE</h6>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-calendar-check text-primary me-2 fs-4"></i>
                                    <div>
                                        <p class="mb-0 fw-bold fs-5">@Model.Reserva.FechaViaje.ToString("dddd, dd 'de' MMMM 'de' yyyy")</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <!-- Pasajeros -->
                            <div class="mb-4">
                                <h6 class="text-muted mb-2">PASAJEROS</h6>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-people text-primary me-2 fs-4"></i>
                                    <p class="mb-0 fw-bold fs-5">@Model.Reserva.NumeroPasajeros persona@(Model.Reserva.NumeroPasajeros > 1 ? "s" : "")</p>
                                </div>
                            </div>

                            <!-- Fecha de Reserva -->
                            <div class="mb-4">
                                <h6 class="text-muted mb-2">FECHA DE RESERVA</h6>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-clock text-primary me-2 fs-4"></i>
                                    <p class="mb-0">@Model.Reserva.FechaReserva.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Resumen de Pago -->
                    <div class="row">
                        <div class="col-12">
                            <h6 class="text-muted mb-3">RESUMEN DE PAGO</h6>
                            
                            <div class="d-flex justify-content-between mb-2">
                                <span>Precio por persona:</span>
                                <span>S/ @Model.Paquete.PrecioPorPersona.ToString("N2")</span>
                            </div>
                            
                            <div class="d-flex justify-content-between mb-3">
                                <span>Número de pasajeros:</span>
                                <span>×@Model.Reserva.NumeroPasajeros</span>
                            </div>
                            
                            <hr>
                            
                            <div class="d-flex justify-content-between align-items-center">
                                <h4 class="mb-0">Total Pagado:</h4>
                                <h3 class="text-primary fw-bold mb-0">S/ @Model.Reserva.PrecioTotal.ToString("N2")</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Próximos Pasos -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-list-check text-primary me-2"></i>Próximos Pasos
                    </h5>
                    <ol class="mb-0">
                        <li class="mb-2">Revisa tu correo electrónico para obtener tu confirmación de reserva</li>
                        <li class="mb-2">Guarda tu número de reserva: <strong>#@Model.Reserva.Id.ToString("D6")</strong></li>
                        <li class="mb-2">Te contactaremos 48 horas antes de tu viaje con los detalles finales</li>
                        <li class="mb-0">Si tienes alguna pregunta, no dudes en contactarnos</li>
                    </ol>
                </div>
            </div>

            <!-- Acciones -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-center mb-4">
                <a asp-action="MisReservas" class="btn btn-primary btn-lg">
                    <i class="bi bi-list-ul me-2"></i>Ver Mis Reservas
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-house me-2"></i>Volver al Inicio
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .success-icon {
            animation: scaleIn 0.5s ease-out;
        }

        @@keyframes scaleIn {
            from {
                transform: scale(0);
                opacity: 0;
            }
            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .card {
            border: none;
        }

        .alert-info {
            background-color: #e7f3ff;
            border-color: #b3d9ff;
        }
    </style>
}
