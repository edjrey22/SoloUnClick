@model SoloUnClick.web.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "SoloUnClick - Tu próxima aventura comienza aquí";
}

<!-- Hero Section con Búsqueda -->
<div class="hero-section bg-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold mb-3">Descubre Tu Próximo Destino</h1>
                <p class="lead mb-4">Explora los mejores paquetes turísticos del Perú</p>
                
                <!-- Barra de búsqueda prominente -->
                <div class="search-box bg-white p-4 rounded shadow-lg">
                    <form asp-controller="Paquetes" asp-action="Index" method="get" class="row g-3">
                        <div class="col-md-8">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" 
                                       class="form-control form-control-lg border-start-0" 
                                       name="busqueda" 
                                       placeholder="¿A dónde quieres ir? (Ej: Cusco, Lima, Arequipa...)"
                                       value="@Model.BusquedaUbicacion">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-lg btn-warning w-100 fw-bold">
                                <i class="bi bi-search me-2"></i>Buscar Paquetes
                            </button>
                        </div>
                    </form>
                    <div class="mt-3">
                        <a asp-controller="Paquetes" asp-action="Index" class="text-muted small text-decoration-none">
                            <i class="bi bi-funnel me-1"></i>Búsqueda avanzada con filtros
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Destinos Populares -->
<div class="container mb-5">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold mb-3">
                <i class="bi bi-stars text-warning me-2"></i>Destinos Populares
            </h2>
            <p class="text-muted">Los lugares más visitados por nuestros viajeros</p>
        </div>
    </div>
    
    @if (Model.DestinosPopulares.Any())
    {
        <div class="row g-4">
            @foreach (var paquete in Model.DestinosPopulares)
            {
                <div class="col-md-4 col-lg-4">
                    <div class="card h-100 shadow-sm hover-shadow">
                        @if (!string.IsNullOrEmpty(paquete.RutaImagenPrincipal))
                        {
                            <img src="@paquete.RutaImagenPrincipal" class="card-img-top" alt="@paquete.Nombre" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <span class="badge bg-info text-dark mb-2">@paquete.TipoViaje</span>
                            <h5 class="card-title fw-bold">@paquete.Nombre</h5>
                            <p class="card-text text-muted">
                                <i class="bi bi-geo-alt me-1"></i>@paquete.Ubicacion
                            </p>
                            <p class="card-text small text-muted">
                                <i class="bi bi-calendar-event me-1"></i>@paquete.DuracionDias días
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small">Desde</span>
                                    <h4 class="text-primary fw-bold mb-0">S/ @paquete.PrecioPorPersona.ToString("N2")</h4>
                                    <span class="text-muted small">por persona</span>
                                </div>
                                <a asp-controller="Paquetes" asp-action="Details" asp-route-id="@paquete.Id" class="btn btn-outline-primary">
                                    Ver más
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No hay destinos populares disponibles en este momento.
        </div>
    }
</div>

<!-- Ofertas de Temporada -->
@if (Model.OfertasTemporada.Any())
{
    <div class="bg-light py-5">
        <div class="container">
            <div class="row mb-4">
                <div class="col-12">
                    <h2 class="fw-bold mb-3">
                        <i class="bi bi-fire text-danger me-2"></i>Ofertas de Temporada
                    </h2>
                    <p class="text-muted">Aprovecha estos paquetes especiales con precios increíbles</p>
                </div>
            </div>
            
            <div class="row g-4">
                @foreach (var paquete in Model.OfertasTemporada)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm border-warning hover-shadow">
                            <div class="position-relative">
                                @if (!string.IsNullOrEmpty(paquete.RutaImagenPrincipal))
                                {
                                    <img src="@paquete.RutaImagenPrincipal" class="card-img-top" alt="@paquete.Nombre" style="height: 180px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 180px;">
                                        <i class="bi bi-image text-white" style="font-size: 2.5rem;"></i>
                                    </div>
                                }
                                <span class="position-absolute top-0 end-0 m-2 badge bg-danger">
                                    <i class="bi bi-percent me-1"></i>OFERTA
                                </span>
                            </div>
                            <div class="card-body">
                                <span class="badge bg-success mb-2">@paquete.TipoViaje</span>
                                <h6 class="card-title fw-bold">@paquete.Nombre</h6>
                                <p class="card-text small text-muted mb-2">
                                    <i class="bi bi-geo-alt me-1"></i>@paquete.Ubicacion
                                </p>
                            </div>
                            <div class="card-footer bg-white">
                                <div class="text-center">
                                    <span class="text-muted small">Desde</span>
                                    <h5 class="text-danger fw-bold mb-2">S/ @paquete.PrecioPorPersona.ToString("N2")</h5>
                                    <a asp-controller="Paquetes" asp-action="Details" asp-route-id="@paquete.Id" class="btn btn-sm btn-warning w-100">
                                        Ver Oferta
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Categorías Populares -->
<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="fw-bold mb-3">Explora por Categoría</h2>
            <p class="text-muted">Encuentra el viaje perfecto según tus intereses</p>
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-md-4">
            <a asp-controller="Paquetes" asp-action="Index" asp-route-tipoViaje="0" class="text-decoration-none">
                <div class="card text-center border-0 shadow-sm hover-shadow categoria-card">
                    <div class="card-body py-4">
                        <i class="bi bi-compass display-4 text-primary mb-3"></i>
                        <h5 class="card-title fw-bold">Aventura</h5>
                        <p class="card-text text-muted small">Descubre la emoción de la naturaleza</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Paquetes" asp-action="Index" asp-route-tipoViaje="1" class="text-decoration-none">
                <div class="card text-center border-0 shadow-sm hover-shadow categoria-card">
                    <div class="card-body py-4">
                        <i class="bi bi-building display-4 text-warning mb-3"></i>
                        <h5 class="card-title fw-bold">Cultural</h5>
                        <p class="card-text text-muted small">Sumérgete en la historia y tradición</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Paquetes" asp-action="Index" asp-route-tipoViaje="4" class="text-decoration-none">
                <div class="card text-center border-0 shadow-sm hover-shadow categoria-card">
                    <div class="card-body py-4">
                        <i class="bi bi-umbrella-fill display-4 text-info mb-3"></i>
                        <h5 class="card-title fw-bold">Playa</h5>
                        <p class="card-text text-muted small">Relájate en las mejores playas</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .hero-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        .search-box {
            transition: transform 0.3s ease;
        }
        
        .search-box:hover {
            transform: translateY(-5px);
        }
        
        .hover-shadow {
            transition: all 0.3s ease;
        }
        
        .hover-shadow:hover {
            transform: translateY(-8px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175)!important;
        }
        
        .categoria-card:hover {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }
        
        .input-group-text {
            border-right: 0;
        }
        
        .form-control {
            border-left: 0;
        }
        
        .form-control:focus {
            border-color: #dee2e6;
            box-shadow: none;
        }
    </style>
}
