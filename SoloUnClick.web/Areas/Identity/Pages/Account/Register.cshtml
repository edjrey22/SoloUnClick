@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrarse";
    Layout = "_Layout";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Agregar clase al body para ocultar navegación principal
        document.body.classList.add('auth-page');
    </script>
    
    <style>
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        
        .form-floating > label {
            padding-left: 2rem;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 0.75rem;
            font-weight: 500;
        }
        
        .btn-primary:hover {
            background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
            transition: all 0.3s ease;
        }
        
        .auth-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }
        
        .auth-subtitle {
            color: #6c757d;
            font-size: 0.95rem;
        }
    </style>
}

<div class="container auth-container">
    <div class="row justify-content-center w-100">
        <div class="col-md-10 col-lg-8">
            <div class="card soft-shadow">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="auth-icon">
                            <i class="bi bi-person-plus-fill text-white" style="font-size: 2.5rem;"></i>
                        </div>
                        <h2 class="fw-bold mb-2">Crear Cuenta</h2>
                        <p class="auth-subtitle mb-0">Únete a SoloUnClick y descubre nuevas aventuras</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <div class="form-floating">
                                    <input asp-for="Input.Nombre" class="form-control" placeholder="Juan" />
                                    <label asp-for="Input.Nombre">
                                        <i class="bi bi-person me-1"></i>Nombre
                                    </label>
                                    <span asp-validation-for="Input.Nombre" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Input.Apellido" class="form-control" placeholder="Pérez" />
                                    <label asp-for="Input.Apellido">
                                        <i class="bi bi-person me-1"></i>Apellido
                                    </label>
                                    <span asp-validation-for="Input.Apellido" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="correo@ejemplo.com" />
                            <label asp-for="Input.Email">
                                <i class="bi bi-envelope me-1"></i>Correo Electrónico
                            </label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="contraseña" />
                            <label asp-for="Input.Password">
                                <i class="bi bi-lock me-1"></i>Contraseña
                            </label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            <div class="form-text small mt-1">Mínimo 6 caracteres, incluye mayúsculas y números</div>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="contraseña" />
                            <label asp-for="Input.ConfirmPassword">
                                <i class="bi bi-lock-fill me-1"></i>Confirmar Contraseña
                            </label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-grid gap-2 mb-3">
                            <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Crear Cuenta
                            </button>
                        </div>

                        <div class="text-center">
                            <p class="mb-0 text-muted small">
                                ¿Ya tienes una cuenta? 
                                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold">
                                    Inicia Sesión
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="card mt-3 soft-shadow">
                    <div class="card-body p-4">
                        <h6 class="card-title text-center mb-3 text-muted">O registrate con</h6>
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="d-grid gap-2">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Registrarse con @provider.DisplayName">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>@provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
